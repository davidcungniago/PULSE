{$PULSE_DOMAIN} {
    encode gzip
    redir / /pulse/ 308
    redir /pulse /pulse/ 308

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    handle_path /pulse/* {
        root * /srv/pulse
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }

    handle {
        respond "Tidak ditemukan" 404
    }
}
